{
  "name": "officefiles",
  "displayName": "OfficeFiles — Agent-editable Office viewers & editors",
  "description": "Custom editors for CSV/XLSX/DOCX/PPTX/Markdown with first-class AI agent control via MCP and Language Model tools. Humans and agents edit the same live document.",
  "version": "0.0.1",
  "publisher": "officefiles",
  "license": "MIT",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCustomEditor:officefiles.csvEditor",
    "onCustomEditor:officefiles.markdownEditor",
    "onStartupFinished"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "officefiles.csvEditor",
        "displayName": "OfficeFiles Grid Editor",
        "selector": [
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.tsv"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "officefiles.markdownEditor",
        "displayName": "OfficeFiles Markdown",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "officefiles.jsonEditor",
        "displayName": "OfficeFiles JSON Editor",
        "selector": [
          {
            "filenamePattern": "*.json"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "officefiles.pdfViewer",
        "displayName": "OfficeFiles PDF Viewer",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "officefiles.imageViewer",
        "displayName": "OfficeFiles Image Viewer",
        "selector": [
          {
            "filenamePattern": "*.png"
          },
          {
            "filenamePattern": "*.jpg"
          },
          {
            "filenamePattern": "*.jpeg"
          },
          {
            "filenamePattern": "*.gif"
          },
          {
            "filenamePattern": "*.bmp"
          },
          {
            "filenamePattern": "*.webp"
          },
          {
            "filenamePattern": "*.ico"
          },
          {
            "filenamePattern": "*.svg"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "officefiles.xlsxViewer",
        "displayName": "OfficeFiles Excel Viewer (beta)",
        "selector": [
          {
            "filenamePattern": "*.xlsx"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "officefiles.docxViewer",
        "displayName": "OfficeFiles Word Reader (beta)",
        "selector": [
          {
            "filenamePattern": "*.docx"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "officefiles.pptxViewer",
        "displayName": "OfficeFiles PowerPoint Reader",
        "selector": [
          {
            "filenamePattern": "*.pptx"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "officefiles.epubViewer",
        "displayName": "OfficeFiles EPUB Reader",
        "selector": [
          {
            "filenamePattern": "*.epub"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "officefiles.archiveViewer",
        "displayName": "OfficeFiles Archive Viewer",
        "selector": [
          {
            "filenamePattern": "*.zip"
          },
          {
            "filenamePattern": "*.vsix"
          },
          {
            "filenamePattern": "*.jar"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "officefiles.openCsvAsGrid",
        "title": "OfficeFiles: Open as Grid Editor"
      },
      {
        "command": "officefiles.agent.listDocuments",
        "title": "OfficeFiles(Agent): List Open Documents"
      },
      {
        "command": "officefiles.agent.readDocument",
        "title": "OfficeFiles(Agent): Read Document JSON"
      },
      {
        "command": "officefiles.agent.applyEdits",
        "title": "OfficeFiles(Agent): Apply Typed Edits"
      },
      {
        "command": "officefiles.agent.searchDocuments",
        "title": "OfficeFiles(Agent): Search Open Documents"
      },
      {
        "command": "officefiles.agent.saveDocument",
        "title": "OfficeFiles(Agent): Save Document"
      }
    ],
    "configuration": {
      "title": "OfficeFiles",
      "properties": {
        "officefiles.agent.allowWrite": {
          "type": "boolean",
          "default": true,
          "description": "Allow AI agents (MCP/chat tools) to mutate documents. Reads are always allowed."
        },
        "officefiles.agent.ipcBridge": {
          "type": "boolean",
          "default": true,
          "description": "Expose a local IPC socket so external MCP clients (bin/mcp-ipc-proxy.js) can drive the live editors in this VS Code window."
        },
        "officefiles.grid.maxRowsPerPage": {
          "type": "number",
          "default": 500,
          "description": "Chunk size for streaming rows into the grid webview."
        }
      }
    }
  },
  "scripts": {
    "build:host": "node esbuild.mjs",
    "build:webview": "vite build",
    "build": "npm run build:host && npm run build:webview",
    "watch:host": "node esbuild.mjs --watch",
    "dev:webview": "vite --port 5740",
    "compile": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --pool=threads"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "^1.94.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "unpdf": "^1.7.0"
  }
}
