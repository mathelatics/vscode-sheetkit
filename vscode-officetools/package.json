{
  "name": "officetools",
  "displayName": "OfficeTools — PDF & Markdown viewers",
  "description": "Custom editors for PDF and Markdown: a fast pdf.js PDF viewer and a feature-rich WYSIWYG Markdown editor/preview.",
  "version": "0.0.1",
  "publisher": "officetools",
  "icon": "image/logo.png",
  "engines": {
    "vscode": "^1.94.0"
  },
  "keywords": [
    "pdf",
    "markdown",
    "viewer",
    "preview",
    "editor",
    "wysiwyg"
  ],
  "categories": [
    "Visualization",
    "Other"
  ],
  "homepage": "https://github.com/mathelatics/vscode-sheetkit",
  "repository": {
    "type": "git",
    "url": "https://github.com/mathelatics/vscode-sheetkit"
  },
  "activationEvents": [
    "onCustomEditor:officetools.markdownEditor",
    "onCustomEditor:officetools.pdfViewer"
  ],
  "main": "./out/extension.js",
  "browser": "./out/extension.web.js",
  "contributes": {
    "commands": [
      {
        "command": "office.markdown.switch",
        "title": "Switch Markdown editor",
        "icon": "$(edit)"
      },
      {
        "command": "office.markdown.paste",
        "title": "Enhance paste in Markdown",
        "enablement": "!office.extensionHost.web"
      }
    ],
    "keybindings": [
      {
        "command": "office.markdown.paste",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "editorTextFocus && resourceLangId == markdown && !office.extensionHost.web"
      },
      {
        "command": "office.markdown.switch",
        "key": "ctrl+alt+e",
        "mac": "ctrl+cmd+e",
        "when": "editorTextFocus && editorLangId == markdown"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "office.markdown.switch",
          "when": "resourceExtname == '.md' || resourceExtname == '.markdown'",
          "group": "navigation@-2"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "officetools.markdownEditor",
        "displayName": "Markdown Editor",
        "selector": [
          {
            "filenamePattern": "file:/**/*.md"
          },
          {
            "filenamePattern": "file:/**/*.markdown"
          },
          {
            "filenamePattern": "vscode-vfs:/**/*.md"
          },
          {
            "filenamePattern": "vscode-vfs:/**/*.markdown"
          },
          {
            "filenamePattern": "vscode-remote:/**/*.md"
          },
          {
            "filenamePattern": "vscode-remote:/**/*.markdown"
          }
        ]
      },
      {
        "viewType": "officetools.pdfViewer",
        "displayName": "PDF Viewer",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ]
      }
    ],
    "configuration": [
      {
        "title": "Markdown",
        "order": 1,
        "properties": {
          "officetools.preventMacOptionKey": {
            "type": "boolean",
            "default": true,
            "description": "Prevent MacOS option key in the markdown editor."
          },
          "officetools.editorTheme": {
            "type": "string",
            "enum": [
              "Auto",
              "Light",
              "Solarized",
              "Warm Light",
              "Dim Light",
              "One Dark",
              "Github Dark",
              "Nord",
              "Monokai",
              "Dracula"
            ],
            "default": "Auto",
            "markdownDescription": "The theme for the Markdown editor."
          },
          "officetools.codeMirrorTheme": {
            "type": "string",
            "enum": [
              "Auto",
              "Github",
              "Solarized Light",
              "Material Light",
              "Quiet Light",
              "One Light",
              "Dracula",
              "Monokai",
              "One Dark",
              "Solarized Dark",
              "Material Dark"
            ],
            "default": "Auto",
            "markdownDescription": "CodeMirror syntax theme for code blocks in the Markdown editor."
          },
          "officetools.mermaidTheme": {
            "type": "string",
            "enum": [
              "Auto",
              "Light",
              "Forest",
              "Ocean",
              "Sunset",
              "Dark",
              "Dracula",
              "Monokai",
              "Nord"
            ],
            "default": "Auto",
            "markdownDescription": "Mermaid diagram theme in the Markdown editor. Auto follows the editor theme."
          },
          "officetools.editMode": {
            "type": "string",
            "enum": [
              "wysiwyg",
              "ir"
            ],
            "default": "wysiwyg",
            "markdownDescription": "Default edit mode for the Markdown editor."
          },
          "officetools.restoreViewState": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Restore caret focus when opening a Markdown file. Scroll position is always restored."
          },
          "officetools.workspacePathAsImageBasePath": {
            "type": "boolean",
            "default": false,
            "description": "Using workspace path as markdown image base path."
          },
          "officetools.pasteImageToWorkspacePath": {
            "type": "boolean",
            "default": false,
            "description": "Paste markdown images into the workspace path and insert image links with a leading slash."
          },
          "officetools.pasterImgPath": {
            "type": "string",
            "default": "image/${fileName}/${now}.${ext}",
            "description": "Markdown paste image path, variables: workspaceDir, fileName, now, date (YYYYMMDD), uuid, ext (file extension)."
          }
        }
      },
      {
        "title": "Markdown PDF",
        "order": 2,
        "properties": {
          "officetools.chromiumPath": {
            "type": "string",
            "description": "Set the chromium browser location for exporting markdown pdf."
          },
          "officetools.puppeteerArgs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Additional arguments to pass to Puppeteer/Chromium when exporting PDF. Example: [\"--no-sandbox\", \"--disable-setuid-sandbox\"] for Linux servers running as root."
          },
          "officetools.pdfMarginTop": {
            "type": "integer",
            "default": 25,
            "description": "Printed pdf default top margin."
          }
        }
      },
      {
        "title": "Telemetry",
        "order": 99,
        "properties": {
          "officetools.enableTelemetry": {
            "type": "boolean",
            "default": true,
            "tags": [
              "telemetry",
              "usesOnlineServices"
            ],
            "markdownDescription": "Enable anonymous usage data collection to help improve OfficeTools. This respects VS Code global telemetry settings (`#telemetry.telemetryLevel#`)."
          }
        }
      }
    ]
  },
  "scripts": {
    "build": "node build.ts --mode=production",
    "package": "npx --yes @vscode/vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies && ovsx publish --no-dependencies",
    "vscode:prepublish": "npm run build",
    "watch": "node build.ts",
    "compile": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/vscode": "^1.64.0",
    "esbuild": "^0.28.1",
    "esbuild-plugin-copy": "2.1.1",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@vscode/extension-telemetry": "^1.5.2",
    "chrome-finder": "^1.0.7",
    "file-type": "^19.6.0",
    "highlight.js": "^11.10.0",
    "katex": "^0.16.2",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-checkbox": "^1.1.0",
    "markdown-it-front-matter": "^0.2.4",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-obsidian-callouts": "^0.3.4",
    "markdown-it-plantuml": "^1.4.1",
    "markdown-it-toc-done-right": "^4.2.0",
    "mermaid": "^11.15.0",
    "mustache": "^4.0.1",
    "node-html-parser": "^7.0.1",
    "pdf-lib": "^1.11.2",
    "puppeteer-core": "^25.1.0",
    "vscode-html-to-docx": "^1.1.3"
  },
  "license": "MIT"
}
