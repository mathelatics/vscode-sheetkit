# OfficeTools — local ignore rules
# (the repo-root .gitignore still applies; this only adds extension-local rules)

# Dependencies
node_modules/

# Build output — regenerated by `npm run build` / `vscode:prepublish`
out/
build/
dist/
*.tsbuildinfo

# Packaged extension
*.vsix

# Source maps / caches
*.map
.cache/
coverage/
.vscode-test/

# Clipboard-image helper scripts referenced by markdownService (not vendored)
/lib/

# Logs & OS junk
*.log
.DS_Store
Thumbs.db
